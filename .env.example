# Get a free key at https://openalex.org/settings/api
# Required since Feb 13, 2026 — without it OpenAlex is limited to ~10 searches/day.
OPENALEX_API_KEY=

# Springer Nature Meta API v2 — free key from https://dev.springernature.com
SPRINGER_API_KEY=

# CORE v3 — free key from https://core.ac.uk/services/api
CORE_API_KEY=

# Elsevier (covers both ScienceDirect and Scopus endpoints) — free key from
# https://dev.elsevier.com. Full-text needs an institutional subscription;
# metadata works with just the key.
ELSEVIER_API_KEY=

# IEEE Xplore Metadata API — requires an institutional email to register at
# https://developer.ieee.org, and manual approval (can take a few days).
IEEE_Xplore_API_KEY=

# NASA ADS — free token from https://ui.adsabs.harvard.edu/user/settings/token
# Covers astronomy/astrophysics/planetary/space science literature.
NASA_ADS_API_KEY=
